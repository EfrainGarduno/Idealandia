# Configuración del entorno de la base de datos
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=secret
DB_NAME=idealandia

# URL de la aplicación (para generar enlaces de recuperación)
APP_URL=http://localhost:3000

# Secreto para firmar tokens JWT (Requerido)
AUTH_SECRET=tu_secreto_jwt_super_seguro_y_largo

# Configuración de email - Modo Básico (si no se usa OAuth2)
SMTP_HOST=smtp.tuservidor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@tudominio.com
SMTP_PASS=tu_contrasena_smtp
SMTP_FROM='"Idealandia" <no-reply@tudominio.com>'

# Configuración de email - Modo OAuth2 (Para Outlook/Hotmail personales)
# Si defines SMTP_CLIENT_ID, el modo OAuth2 se activará y el Modo Básico será ignorado.
# SMTP_USER=tu_correo@hotmail.com
# SMTP_CLIENT_ID=tu_client_id_de_azure_ad
# SMTP_CLIENT_SECRET=tu_client_secret_de_azure_ad
# SMTP_REFRESH_TOKEN=tu_refresh_token_offline_access

# Integración con Gemini
GEMINI_API_KEY=tu_api_key_de_gemini
